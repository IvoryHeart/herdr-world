#!/usr/bin/env sh
set -eu

# Git exports repository-local variables to hooks, but the check creates test repos.
for name in $(git rev-parse --local-env-vars); do
  unset "$name"
done

artifact_dir=$(git rev-parse --show-toplevel)/.agents/delivery
mkdir -p "$artifact_dir"
log_file=$(mktemp "$artifact_dir/pre-push.XXXXXX")
report_file="$artifact_dir/pre-push.tsv"
head_sha=$(git rev-parse --verify HEAD 2>/dev/null || printf 'unborn')
recorded_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
started_at=$(date +%s)
gate=changed
base=
all_units=

# Code pushes check what changed since the remote branch (or since main for a
# new branch): static checks and affected non-browser units only. Browser and
# behavioral acceptance run in CI. HERDR_WORLD_PREPUSH=full opts in locally.
# The scoped gate reads this worktree, so a push of anything but its HEAD
# (another branch, several refs) runs all non-browser units. A Markdown-only
# follow-up can use the docs gate if this worktree already passed a code gate
# on an ancestor. A push that only merges origin/main into the pushed branch
# (scripts/merge-push.ts defines this conservatively) runs static checks only:
# both sides were tested and CI runs the full gate on the merge.
if read -r local_ref local_sha remote_ref remote_sha; then
  if read -r extra_line || [ "$local_sha" != "$head_sha" ]; then
    all_units=--all-units
  fi
  case "$gate:$local_ref" in
    changed:refs/heads/*)
      if [ -z "$all_units" ] && [ "$local_sha" = "$head_sha" ] &&
        git merge-base --is-ancestor "$remote_sha" "$head_sha" 2>/dev/null; then
        base=$remote_sha
      fi
      if [ -z "$all_units" ] && [ "$local_sha" = "$head_sha" ] &&
        git rev-parse --quiet --verify "$head_sha^2" >/dev/null &&
        merge_note=$(bun scripts/merge-push.ts "$remote_sha" 2>&1); then
        gate=static
        printf 'pre-push: %s; running static checks only\n' "$merge_note" >&2
      fi
      if [ -z "$all_units" ] && [ "$gate" = changed ] && [ "$local_sha" = "$head_sha" ] && [ -f "$report_file" ]; then
        full_sha=$(awk -F '\t' '$3 == "0" && ($5 == "" || $5 == "full" || $5 == "changed") { sha=$2 } END { print sha }' "$report_file")
        if [ -n "$full_sha" ] &&
          git merge-base --is-ancestor "$remote_sha" "$head_sha" 2>/dev/null &&
          git merge-base --is-ancestor "$full_sha" "$head_sha" 2>/dev/null &&
          bun scripts/validation-scope.ts "--docs-since=$full_sha" >/dev/null 2>&1; then
          gate=docs
        fi
      fi
      ;;
  esac
fi

if [ "${HERDR_WORLD_PREPUSH:-}" = full ]; then
  gate=full
fi
if [ "$gate" = docs ]; then
  check_command=check:docs
elif [ "$gate" = static ]; then
  check_command=check:static
elif [ "$gate" = full ]; then
  check_command=check:delivery
else
  check_command=check:changed
fi
set -- run "$check_command"
if [ "$gate" = changed ] && [ -n "$all_units" ]; then
  set -- "$@" "$all_units"
fi
if [ "$gate" = changed ] && [ -n "$base" ]; then
  set -- "$@" "--base=$base"
fi

if bun "$@" >"$log_file" 2>&1; then
  ended_at=$(date +%s)
  elapsed=$((ended_at - started_at))
  printf '%s\t%s\t0\t%s\t%s\n' "$recorded_at" "$head_sha" "$elapsed" "$gate" >> "$report_file"
  rm -f "$log_file"
  printf 'pre-push: bun run %s passed in %ss\n' "$check_command" "$elapsed" >&2
  exit 0
else
  status=$?
  ended_at=$(date +%s)
  elapsed=$((ended_at - started_at))
  printf '%s\t%s\t%s\t%s\t%s\n' "$recorded_at" "$head_sha" "$status" "$elapsed" "$gate" >> "$report_file"
  printf 'pre-push: bun run %s failed (exit %s, %ss)\n' "$check_command" "$status" "$elapsed" >&2
  awk '/^\(fail\)/ { print; if (++count == 10) exit }' "$log_file" >&2
  tail -20 "$log_file" >&2
  printf 'Full log: %s\n' "$log_file" >&2
  exit "$status"
fi
