#!/usr/bin/env sh
set -eu

# Git exports repository-local variables; privacy checks create isolated repos.
for name in $(git rev-parse --local-env-vars); do unset "$name"; done
artifact_dir=$(git rev-parse --show-toplevel)/.agents/delivery
mkdir -p "$artifact_dir"
refs_file=$(mktemp "$artifact_dir/push-refs.XXXXXX")
started_at=$(date +%s)
head_sha=$(git rev-parse --verify HEAD 2>/dev/null || printf unborn)
recorded_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
finish() {
  status=$?
  elapsed=$(($(date +%s) - started_at))
  printf '%s\t%s\t%s\t%s\tformat-privacy\n' "$recorded_at" "$head_sha" "$status" "$elapsed" >> "$artifact_dir/pre-push.tsv"
  rm -f "$refs_file"
}
trap finish 0
cat > "$refs_file"
# Branches, tags, multiple refs and deletions use the same cheap boundary.
# Committed bytes are scanned; static, unit, size and description checks run in CI.
bun run format:check
bun scripts/check-privacy.ts --pre-push "$refs_file"
