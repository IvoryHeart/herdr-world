[Unit]
Description=Herdr World
Documentation=https://github.com/IvoryHeart/herdr-world
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/herdr-world/herdr-world.env
ExecStart=%h/.local/bin/herdr-world
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=default.target
